{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@learn2hire/types": ["packages/types/src"],
      "@learn2hire/validation": ["packages/validation/src"],
      "@learn2hire/design-system": ["packages/design-system/src"]
    }
  },
  "exclude": ["node_modules", ".next", "dist", "build"]
}
