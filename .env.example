# ==============================================================================
# LEARN-2-HIRE ENVIRONMENT CONFIGURATION
# Copy this file to .env or .env.local for development.
# NEVER commit .env or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. SUPABASE (AUTH, DATABASE, STORAGE)
# ------------------------------------------------------------------------------
# Client-side safe public credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only private admin credentials (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# PostgreSQL Database Connection
# Pooled connection string for application runtime (PgBouncer/Supabase pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# Direct connection string for migrations and schema DDL
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. REDIS & CACHING / WORKER QUEUE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN=

# ------------------------------------------------------------------------------
# 4. AI SYSTEM PROVIDERS (PROVIDER-AGNOSTIC ABSTRACTION)
# ------------------------------------------------------------------------------
# Active AI provider: 'openai' | 'anthropic' | 'gemini' | 'groq' | 'ollama'
AI_PROVIDER_DEFAULT=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 5. CAREER & OCCUPATIONAL DATA PROVIDERS
# ------------------------------------------------------------------------------
# ESCO API (European Classification of Skills, Competences and Occupations)
ESCO_API_BASE_URL=https://ec.europa.eu/esco/api
# O*NET Web Services
ONET_API_USERNAME=
ONET_API_PASSWORD=
ONET_API_BASE_URL=https://services.onetcenter.org/ws

# ------------------------------------------------------------------------------
# 6. EXTERNAL JOB & OPPORTUNITY PROVIDERS
# ------------------------------------------------------------------------------
# Adzuna API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Jooble API
JOOBLE_API_KEY=

# The Muse API
THE_MUSE_API_KEY=

# Remotive (Public API / Feed)
REMOTIVE_API_BASE_URL=https://remotive.com/api/remote-jobs

# ------------------------------------------------------------------------------
# 7. VOICE & SPEECH PROVIDERS (INTERVIEW SYSTEM)
# ------------------------------------------------------------------------------
# Active voice provider: 'webspeech' | 'elevenlabs' | 'deepgram'
VOICE_PROVIDER_DEFAULT=webspeech
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & SECURITY
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info
ADMIN_SECRET_KEY=super-secure-internal-admin-key-change-in-production
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
